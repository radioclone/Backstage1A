# Sequence Wallet Configuration
NEXT_PUBLIC_SEQUENCE_PROJECT_KEY=your_sequence_project_key
NEXT_PUBLIC_SEQUENCE_WAAS_URL=your_sequence_waas_url

# OpenAI (for Agents)
OPENAI_API_KEY=your_openai_api_key

# WebSocket Configuration
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:3000/socket

# Feature Flags
NEXT_PUBLIC_ENABLE_AGENT_INTERACTIONS=true
NEXT_PUBLIC_ENABLE_3D_RENDERING=true

# Development vs Production
NODE_ENV=development
